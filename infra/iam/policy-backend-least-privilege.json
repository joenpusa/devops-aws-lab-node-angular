{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3MaterialsImagesAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::materials-images-dev",
        "arn:aws:s3:::materials-images-dev/*"
      ]
    },
    {
      "Sid": "DynamoDBApplicationLogsAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:*:table/application-logs"
    },
    {
      "Sid": "SQSUserDeleteQueueAccess",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:*:user-delete-queue"
    }
  ]
}
